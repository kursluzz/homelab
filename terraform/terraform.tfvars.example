# VM inventory: every Kubernetes node, its address and size lives here.
# Physical hosts live in ansible/inventory.yaml; this file refers to them by name.
# Copy to terraform.tfvars and edit. terraform.tfvars is committed on purpose
# (private LAN addresses are harmless). Credentials are not kept here; see
# "Local credentials" in README.md.

cluster_name     = "homelab"
cluster_endpoint = "192.168.1.40" # virtual IP shared by the control-plane nodes
gateway          = "192.168.1.1"
bridge           = "br0" # LAN bridge on every host; VMs get LAN addresses

# LAN plan (192.168.1.0/24):
#   .1         router
#   .2-.19     other devices with static addresses
#   .20-.29    physical hosts (ansible/inventory.yaml; DHCP reservations by MAC)
#   .30-.39    VMs and containers outside Kubernetes (spare)
#   .40        Kubernetes API virtual IP
#   .41-.49    control-plane nodes
#   .50-.69    workers
#   .70-.99    LoadBalancer IPs for Services (Cilium LB IPAM)
#   .100-.200  router DHCP pool

# Host RAM, for the budgets. Terraform reaches each host through the Incus
# remote of the same name (~/.config/incus).
hosts = {
  home  = { ram_gb = 20 }
  lab-1 = { ram_gb = 64 }
  lab-2 = { ram_gb = 16 }
}

# Incus storage pools ("dir" driver on existing filesystems, no repartitioning).

# Kubernetes nodes (VMs). One control-plane node per host: etcd survives the
# loss of any one host. vCPUs may be overcommitted; pod requests/limits, not
# VM cores, are what keep workloads apart.
nodes = {
  cp-1 = { host = "lab-1", role = "controlplane", ip = "192.168.1.41", cores = 2, ram_gb = 4, disk_gb = 40, pool = "default" }
  cp-2 = { host = "lab-2", role = "controlplane", ip = "192.168.1.42", cores = 2, ram_gb = 4, disk_gb = 40, pool = "default" }
  cp-3 = { host = "home", role = "controlplane", ip = "192.168.1.43", cores = 2, ram_gb = 4, disk_gb = 40, pool = "default" }

  w-1 = { host = "lab-1", role = "worker", ip = "192.168.1.51", cores = 4, ram_gb = 18, disk_gb = 150, pool = "default" }
  w-2 = { host = "lab-1", role = "worker", ip = "192.168.1.52", cores = 4, ram_gb = 18, disk_gb = 150, pool = "default" }
  w-3 = { host = "lab-2", role = "worker", ip = "192.168.1.53", cores = 4, ram_gb = 8, disk_gb = 100, pool = "default" }
  w-4 = { host = "home", role = "worker", ip = "192.168.1.54", cores = 2, ram_gb = 6, disk_gb = 80, pool = "default" }
}
