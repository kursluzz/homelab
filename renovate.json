{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "argocd": { "fileMatch": ["^kubernetes/.+\\.ya?ml$"] },
  "pre-commit": { "enabled": true },
  "customManagers": [
    {
      "description": "Versions in Ansible vars marked with a '# renovate:' comment",
      "customType": "regex",
      "fileMatch": ["^ansible/.+\\.ya?ml$"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\w+: \"?(?<currentValue>[^\"\\s]+)\"?"
      ]
    },
    {
      "description": "Versions in Terraform variable files marked with a '# renovate:' comment",
      "customType": "regex",
      "fileMatch": ["^terraform/.+\\.tfvars$"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\w+\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ]
    }
  ]
}
