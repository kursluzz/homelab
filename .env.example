# Copy to .env and fill in. .env is gitignored; see "Local credentials" in README.md.
# Use absolute paths: tools resolve relative paths against the current directory.

# SOPS private key (age). Its public key is the recipient in .sops.yaml.
SOPS_AGE_KEY_FILE=/path/to/homelab/homelab.age.key

# Cluster access, written by Terraform. talosctl reads ~/.talos/config by default.
KUBECONFIG=/home/<user>/.kube/homelab.yaml
